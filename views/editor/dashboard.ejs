<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | The Daily Web</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/editor.css">
</head>
<body class="editor-page">
  <header class="masthead"><a class="brand" href="/">The Daily Web</a><span>Editorial desk</span></header>
  <main>
    <div class="page-heading"><p class="eyebrow">Newsroom / Editor</p><h1>Article desk</h1><p>Review submissions, guide corrections and publish the next story.</p></div>
    <form class="filter-bar" action="/editor" method="get">
      <label for="status">Article status</label>
      <select id="status" name="status">
        <option value="">All statuses</option>
        <% statuses.forEach(status => { %>
          <option value="<%= status %>" <%= selectedStatus === status ? 'selected' : '' %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option>
        <% }) %>
      </select>
      <button type="submit">Apply filter</button>
      <span class="muted"><%= articles.length %> article<%= articles.length === 1 ? '' : 's' %></span>
    </form>
    <% if (!articles.length) { %>
      <section class="panel empty"><h2>No articles here yet</h2><p>Submitted stories will appear here. Try another status filter.</p><a href="/editor">View all articles</a></section>
    <% } else { %>
      <div class="table-scroll">
        <table>
          <caption class="sr-only">Newsroom articles, most recently updated first</caption>
          <thead><tr><th scope="col">Article</th><th scope="col">Reporter</th><th scope="col">Status</th><th scope="col">Public version</th><th scope="col">Last updated</th><th scope="col">Action</th></tr></thead>
          <tbody>
            <% articles.forEach(article => { %>
              <tr>
                <th scope="row"><%= article.workingVersion?.title || 'Untitled article' %><small><%= article.workingVersion?.category || 'Uncategorized' %></small></th>
                <td><%= article.reporter?.username || 'Reporter unavailable' %></td>
                <td><span class="badge <%= article.status %>"><%= article.status %></span></td>
                <td><%= article.publishedVersion ? 'Published version live' : 'Not published' %></td>
                <td><time datetime="<%= article.updatedAt.toISOString() %>"><%= article.updatedAt.toLocaleString('en-GB') %></time></td>
                <td><a class="review-link" href="/editor/articles/<%= article._id %>">Review<span class="sr-only"> <%= article.workingVersion?.title || 'Untitled article' %></span> &rarr;</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
