<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | The Daily Web</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/editor.css">
</head>
<body class="editor-page">
  <%- include('../partials/editor-header', { navSection: 'articles', navCurrent: 'articles' }) %>
  <main>
    <div class="page-heading"><p class="eyebrow">Newsroom / Editor</p><h1>Article desk</h1><p>Review submissions, guide corrections and publish the next story.</p></div>
    <form class="filter-bar" action="/editor" method="get" data-results-form>
      <label for="search">Title contains</label><input id="search" name="search" type="search" maxlength="200" value="<%= search %>">
      <label for="status">Article status</label>
      <select id="status" name="status">
        <option value="">All statuses</option>
        <% statuses.forEach(status => { %>
          <option value="<%= status %>" <%= selectedStatus === status ? 'selected' : '' %>><%= statusLabels[status] %></option>
        <% }) %>
      </select>
      <button type="submit">Apply filter</button>
    </form>
    <p class="results-status" data-results-status role="status" aria-live="polite"></p>
    <div id="article-results" data-results>
      <%- include('partials/article-results') %>
    </div>
  </main>
  <script src="/js/listResults.js" defer></script>
</body>
</html>
