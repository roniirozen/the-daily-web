<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | The Daily Web</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/editor.css">
  <link rel="stylesheet" href="/css/analytics.css">
</head>
<body class="editor-page">
  <%- include('../partials/editor-header', { navSection: 'articles' }) %>
  <main>
    <div class="page-heading">
      <p class="eyebrow">Newsroom / Analytics</p>
      <h1><%= articleTitle %></h1>
      <p>Views over time, with every editorial approval marked on the timeline.</p>
    </div>

    <section class="panel">
      <div class="analytics-summary">
        <div>
          <p class="eyebrow">Status</p>
          <span class="badge <%= article.status %>"><%= statusLabels[article.status] %></span>
        </div>
        <div>
          <p class="eyebrow">Total views</p>
          <p id="total-views" class="stat-number">&ndash;</p>
        </div>
      </div>

      <div id="chart-empty" class="empty" hidden>
        <h2>No view data yet</h2>
        <p>Once readers view this article, its hourly view counts will appear here.</p>
      </div>

      <div id="chart-wrapper">
        <canvas id="analytics-chart" width="960" height="360" aria-label="Article views over time, with publication events marked" role="img"></canvas>
        <ul id="chart-legend" class="chart-legend">
          <li><span class="legend-swatch views"></span> Views per interval</li>
          <li><span class="legend-swatch initial"></span> Initial publication</li>
          <li><span class="legend-swatch update"></span> Update approved</li>
        </ul>
      </div>
    </section>

    <section class="panel" aria-labelledby="impact-heading">
      <h2 id="impact-heading">Publication and update impact</h2>
      <p>Compare recorded views in the 24 hours before and after each approval. Counts use the start of each time bucket; an empty interval means no recorded views.</p>
      <ol id="update-comparisons" aria-live="polite"></ol>
    </section>

    <section class="panel" aria-labelledby="stats-heading">
      <h2 id="stats-heading">Manage view statistics</h2>
      <p class="muted">Each row is one hourly bucket of recorded views. Changes update the graph and the article's popularity total.</p>
      <form id="stats-create" class="stats-create">
        <div>
          <label for="stats-hour">Hour</label>
          <input id="stats-hour" name="bucketStart" type="datetime-local" step="3600" required>
        </div>
        <div>
          <label for="stats-count">Views</label>
          <input id="stats-count" name="viewCount" type="number" min="0" max="1000000000" step="1" required>
        </div>
        <button type="submit">Add statistics</button>
      </form>
      <p id="stats-message" class="stats-message" role="status" aria-live="polite"></p>
      <div class="table-scroll">
        <table>
          <caption class="sr-only">Hourly view statistics, newest first</caption>
          <thead><tr><th scope="col">Hour</th><th scope="col">Views</th><th scope="col">Actions</th></tr></thead>
          <tbody id="stats-rows"></tbody>
        </table>
      </div>
      <nav class="pagination" aria-label="Statistics pages">
        <button id="stats-prev" class="secondary" type="button">Newer</button>
        <span id="stats-page">Page 1</span>
        <button id="stats-next" class="secondary" type="button">Older</button>
      </nav>
    </section>

    <p><a href="/editor/articles/<%= article._id %>">&larr; Back to review</a></p>
  </main>

  <script>
    window.__ANALYTICS_DATA_URL__ = '/editor/analytics/<%= article._id %>/data';
    window.__ANALYTICS_STATS_URL__ = '/editor/analytics/<%= article._id %>/stats';
  </script>
  <script src="/js/analytics.js"></script>
  <script src="/js/viewStatsAdmin.js" defer></script>
</body>
</html>
