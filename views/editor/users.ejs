<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | The Daily Web</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/editor.css">
</head>
<body class="editor-page">
  <%- include('../partials/editor-header', { navSection: 'users', navCurrent: 'users' }) %>
  <main>
    <div class="page-heading"><p class="eyebrow">Newsroom / Administration</p><h1>People in the newsroom</h1><p>Manage Reporter and Editor accounts and access.</p><a class="button-link" href="/editor/users/new">Create user</a></div>
    <form class="filter-bar" action="/editor/users" method="get" data-results-form>
      <label for="search">Username starts with</label><input id="search" type="search" name="search" maxlength="60" value="<%= search %>" placeholder="Search usernames">
      <button type="submit">Search</button><a href="/editor/users" data-results-link>Clear</a>
    </form>
    <p class="results-status" data-results-status role="status" aria-live="polite"></p>
    <div id="user-results" data-results>
      <%- include('partials/user-results') %>
    </div>
  </main>
  <script src="/js/listResults.js" defer></script>
</body>
</html>
