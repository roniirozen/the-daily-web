<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | The Daily Web</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/reporter.css">
</head>
<body>
  <%- include('../partials/reporter-header', { navCurrent: 'articles' }) %>
  <main class="container newsroom">
    <div class="workspace-heading">
      <div><p class="section-label">NEWSROOM</p><h1>Your articles</h1>
        <p>Write, revise, and send your stories to the editor.</p>
      </div>
      <a class="primary-button" href="/reporter/articles/new">New article</a>
    </div>
    <p class="visually-hidden" data-results-status role="status" aria-live="polite"></p>
    <div id="story-results" data-results>
      <%- include('partials/article-list') %>
    </div>
  </main>
  <script src="/js/listResults.js" defer></script>
</body>
</html>
