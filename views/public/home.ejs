
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>The Daily Web</title>

  <link rel="stylesheet" href="/css/main.css">
</head>

<body>

  <header class="site-header">
    <div class="container header-content">

      <a href="/" class="logo">
        The Daily Web
      </a>

      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/login">Reporter / Editor Login</a>
      </nav>

    </div>
  </header>

  <main>

    <section class="hero">
      <div class="container">

        <p class="hero-label">LATEST STORIES</p>

        <h1>
          News that matters.<br>
          Updated throughout the day.
        </h1>

        <p class="hero-description">
          Follow the latest stories across technology, business,
          world news, culture and more.
        </p>

      </div>
    </section>

    <section class="news-section">

      <div class="container content-layout">

        <div class="news-content">

          <div class="section-heading">
            <div>
              <p class="section-label">THE DAILY FEED</p>
              <h2>Latest News</h2>
            </div>
          </div>

          <div id="articles-container" class="articles-grid" aria-live="polite"></div>

          <p id="feed-empty" class="empty-message" hidden>
            No articles are available right now.
          </p>

          <p id="feed-error" class="empty-message feed-error" hidden>
            Unable to load the news feed. Please try again in a moment.
          </p>

          <div id="feed-loading" class="feed-loading" hidden>
            Loading more stories...
          </div>

          <div id="feed-sentinel" aria-hidden="true"></div>

        </div>

        <aside class="sidebar">

          <section class="sidebar-card">
            <p class="sidebar-label">WEATHER</p>

            <h3>Weather</h3>

            <p>
              Live weather information will appear here.
            </p>
          </section>

        </aside>

      </div>

    </section>

  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; 2026 The Daily Web</p>
    </div>
  </footer>

  <script src="/js/feed.js" defer></script>

</body>
</html>
