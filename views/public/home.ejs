
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>The Daily Web</title>

  <link rel="stylesheet" href="/css/main.css">
</head>

<body>

  <header class="site-header">
    <div class="container header-content">

      <a href="/" class="logo">
        The Daily Web
      </a>

      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/login">Reporter / Editor Login</a>
      </nav>

    </div>
  </header>

  <main>

    <section class="hero">
      <div class="container">

        <p class="hero-label">LATEST STORIES</p>

        <h1>
          News that matters.<br>
          Updated throughout the day.
        </h1>

        <p class="hero-description">
          Follow the latest stories across technology, business,
          world news, culture and more.
        </p>

      </div>
    </section>

    <section class="news-section">

      <div class="container content-layout">

        <div class="news-content">

          <div class="section-heading">
            <div>
              <p class="section-label">THE DAILY FEED</p>
              <h2>Latest News</h2>
            </div>
          </div>

          <div id="articles-container" class="articles-grid">

            <article class="article-card">

              <div class="article-image placeholder-image">
                Article image
              </div>

              <div class="article-content">

                <div class="article-meta">
                  <span>Technology</span>
                  <span>September 6, 2026</span>
                </div>

                <h3>
                  <a href="#">
                    Example headline for The Daily Web
                  </a>
                </h3>

                <p>
                  Article summaries will appear here once the news feed
                  is connected to the database.
                </p>

                <div class="article-author">
                  By Example Reporter
                </div>

              </div>

            </article>

          </div>

        </div>

        <aside class="sidebar">

          <section class="sidebar-card">
            <p class="sidebar-label">WEATHER</p>

            <h3>Weather</h3>

            <p>
              Live weather information will appear here.
            </p>
          </section>

        </aside>

      </div>

    </section>

  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; 2026 The Daily Web</p>
    </div>
  </footer>

</body>
</html>
